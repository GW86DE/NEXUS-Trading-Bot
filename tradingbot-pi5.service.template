[Unit]
Description=TradingBot __VERSION__ NEXUS Pi5 8GB (eToro + OKX)
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=notify
User=__USER__
Group=__GROUP__
WorkingDirectory=__BOTDIR__
ExecStartPre=__BOTDIR__/.venv/bin/python __BOTDIR__/pi_preflight.py --service
ExecStart=__BOTDIR__/.venv/bin/python __BOTDIR__/pi_service.py
ExecStopPost=__BOTDIR__/.venv/bin/python __BOTDIR__/pi_service_event.py $SERVICE_RESULT $EXIT_CODE $EXIT_STATUS
Restart=on-failure
RestartSec=20s
RestartPreventExitStatus=75 78
TimeoutStartSec=300s
TimeoutStopSec=60s
KillSignal=SIGTERM
WatchdogSec=180s
NotifyAccess=main

# Pi-5-Stabilitaet: BLAS/NumPy darf nicht unkontrolliert alle Kerne mit
# Unterthreads belegen. Der Tradingpfad ist ueberwiegend Netzwerk-/I/O-lastig.
Environment=TRADINGBOT_PI_MODE=1
Environment=TRADINGBOT_PI_TARGET=pi5-8gb
# Logger bleibt in rotierenden Dateien; stdout/journal bekommt weiterhin die
# wichtigen print-/Statusmeldungen, aber nicht jede Logzeile doppelt.
Environment=TRADINGBOT_LOG_TO_STDOUT=0
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=NUMEXPR_NUM_THREADS=1
Environment=TZ=Europe/Berlin

# Genug Reserve fuer Desktop/SSH/Kernel lassen. Diese Limits veraendern keine
# Tradinglogik; sie verhindern nur, dass ein fehlerhafter Prozess den Pi leert.
CPUQuota=300%
MemoryHigh=2500M
MemoryMax=3500M
TasksMax=256
LimitNOFILE=4096
Nice=3
UMask=0077

# Unkritische systemd-Haertung ohne Netzwerk-/Dateizugriffe des Bots zu brechen.
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
